                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {% if section_pipeline %}<h3 id="id_order_qc"><a id="生物信息分析流程">{{section_pipeline}} 生物信息分析流程</a></h3>{% endif %}
    <p class="center">
        <img class="normal4" style="width: 75%; display: block; margin: 0 auto;" src="images/935K.png"/>
    </p>
    {% if fig_pipeline %}<p class="name_fig" style="font-weight: bold; text-align: center;">图 {{fig_pipeline}} 生物信息分析流程图</p>{% endif %}


{% if flag_qc %}
{% if section_qc %}<h3 id="id_order_qc"><a id="数据质控">{{section_qc}}　数据质控</a></h3>{% endif %}

<p class="paragraph">
通过原始信号值计算位点甲基化程度，一般采用beta值（β）作为衡量某位点甲基化程度的指标。该值区间（0,1），理论上越接近于1表明该位点甲基化程度越高，越接近0该位点甲基化程度越低。一般认为，beta值大于0.6是高甲基化（Hypermethylated），beta值小于0.2是低甲基化（Hypomethylated），beta值处于0.2~0.6范围是部分甲基化状态（Heterogeneously Methylated）。
</p>
    <p>beta值的计算公式如下: $$ \beta = \frac{M}{M + U} $$</p>
<p class="paragraph">其中，M代表甲基化的探针信号，U代表未甲基化的探针信号。</p>
<p class="paragraph">将芯片原始数据idat文件导入R包sesame（V1.17.11）<sup>[1]</sup>中进行beta值的计算，并对芯片数据进行质控，具体数据质控步骤如下：</p>
   <!-- 去掉自动编号，使用自定义（1）（2）格式 -->
<ol style="list-style: none; padding-left: 2em;">
  <li>（1）detected p-value过滤：将 detected p值大于0.05的位点全部去掉；</li>
  <li>（2）非特异性探针过滤；</li>
  <li>（3）染色偏倚校正；</li>
  <li>（4）背景信号的校正。</li>
</ol>
  <!-----------------------------------------如果不做差异，beta值密度分析不展示----------------------------------------->
{% if flag_dmp %}
<a name="beta值密度分析"></a>
{% if subsection_qc_density %}<h4>{{subsection_qc_density}}　beta值密度分析</h4>{% endif %}
<p class="paragraph">
通过样本beta值密度曲线图展示样本间、组间的甲基化情况，能够对项目样本的整体情况有个直观了解，初步分析样本情况是否预期的实验设计。
</p>

<p class="center">
<div class="row gallery-row">
  <div class="col-1">
    <div id="gallery_figure_density_button_prev" class="button_prev" onclick="prev(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_prev">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="8789.5,4902.8 8789.5,5846.4 6801.7,8000 8789.5,10253.6 8789.5,11097.2 5930.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-6">
    <div class="tab-content" id="gallery_figure_density_nav-tabContent">
      {% for item in figure_beta %}
      {% if "densityPlot" in item.1 %}
      <div class="tab-pane fade{% if forloop.first %} show active{% endif %}" id="gallery_figure_density_pane_{{ item.0 }}" role="tabpanel"
        aria-labelledby="gallery_figure_density_list_{{ item.0 }}" onclick="trans(this.id)"><img
          class="img-gallery" src="{{ item.1 }}" /></div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="col-1">
  <div id="gallery_figure_density_button_next" class="button_next" onclick="next(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_next">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="7210.5,4902.8 7210.5,5846.4 9198.3,8000 7210.5,10253.6 7210.5,11097.2 10069.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-4">
    <input class="form-control" id="gallery_figure_density_InputList" type="text" placeholder="Search..">
    <div class="list-group" id="gallery_figure_density_list-tab" role="tablist">
      {% for item in figure_beta %}
      {% if "densityPlot" in item.1 %}
      <a class="list-group-item list-group-item-action{% if forloop.first %} active{% endif %}" id="gallery_figure_density_list_{{ item.0 }}"
        data-toggle="list" href="#gallery_figure_density_pane_{{ item.0 }}" role="tab"
        aria-controls="{{ item.0 }}">{{ item.0 }} 甲基化beta值密度分布曲线图</a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
</p>

{% if fig_qc_density %}<p class="name_fig" style="font-weight: bold; text-align: center;">图 {{fig_qc_density}} 甲基化beta值密度分布曲线图</p>{% endif %}
<p class="premark">图注：横坐标为beta，纵坐标为密度值。正常样本的密度分布曲线应为中间平滑，两端呈现两个峰值，即绝大部分的甲基化位点处于高甲基化和低甲基化的状态。图标题中括号内的数字表示过滤后剩下用于后续分析的探针数。</p>
<p class="premark">结果文件路径：见Result目录下1.QC/1_Raw_Data_and_Pre_Process/*Norm_densityPlot.png/pdf文件。</p>
{% endif %}

<hr/>
</p><br/>
<a name="beta值箱线图数据分布"></a>
{% if subsection_qc_boxplot %}<h4>{{subsection_qc_boxplot}}　beta值箱线图数据分布</h4>{% endif %}
<p class="paragraph">完成质控后获得各样本甲基化水平如下图所示：</p>

<p class="center">
<div class="row gallery-row">
  <div class="col-1">
    <div id="gallery_figure_boxplot_button_prev" class="button_prev" onclick="prev(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_prev">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="8789.5,4902.8 8789.5,5846.4 6801.7,8000 8789.5,10253.6 8789.5,11097.2 5930.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-6">
    <div class="tab-content" id="gallery_figure_boxplot_nav-tabContent">
      {% for item in figure_boxplot %}
      {% if "Norm_BoxPlot" in item.1 %}
      <div class="tab-pane fade{% if forloop.first %} show active{% endif %}" id="gallery_figure_boxplot_pane_{{ item.0 }}" role="tabpanel"
        aria-labelledby="gallery_figure_boxplot_list_{{ item.0 }}" onclick="trans(this.id)"><img
          class="img-gallery" src="{{ item.1 }}" /></div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="col-1">
  <div id="gallery_figure_boxplot_button_next" class="button_next" onclick="next(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_next">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="7210.5,4902.8 7210.5,5846.4 9198.3,8000 7210.5,10253.6 7210.5,11097.2 10069.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-4">
    <input class="form-control" id="gallery_figure_boxplot_InputList" type="text" placeholder="Search..">
    <div class="list-group" id="gallery_figure_boxplot_list-tab" role="tablist">
      {% for item in figure_boxplot %}
      {% if "Norm_BoxPlot" in item.1 %}
      <a class="list-group-item list-group-item-action{% if forloop.first %} active{% endif %}" id="gallery_figure_boxplot_list_{{ item.0 }}"
        data-toggle="list" href="#gallery_figure_boxplot_pane_{{ item.0 }}" role="tab"
        aria-controls="{{ item.0 }}">{{ item.0 }} 甲基化水平beta值箱线图</a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
</p>

{% if fig_qc_boxplot %}<p class="name_fig" style="font-weight: bold; text-align: center;">图 {{fig_qc_boxplot}} 甲基化水平beta值箱线图</p>{% endif %}
<p class="premark">图注：横坐标为样本名称，纵坐标为样本beta值，箱线图（Box-whisker Plot）利用最小值、 下四分位数、中位数、上四分位数和最大值五个统计量，对各样本整体甲基化分散程度等信息进行展示，可以根据分布接近程度判断组内重复性和组间差异大小。</p>
<p class="premark">结果文件路径：见Result目录下1.QC/1_Raw_Data_and_Pre_Process/*Beta_Norm_BoxPlot.png/pdf文件，作图数据基于同目录下的1_Raw_Data_and_Pre_Process/*/normbetas.csv。为避免excel打开时因位点较多而显示不全的情况，建议老师使用Notepad++软件进行查看。</p>

<hr/>
</p><br/>
<a name="beta值堆叠图数据分布"></a>
{% if subsection_qc_normbeta %}<h4>{{subsection_qc_normbeta}}　beta值堆叠图数据分布</h4>{% endif %}
<p class="paragraph">所有样本分为三类beta值：未甲基化（beta≤0.2）、中间甲基化（0.2< beta <0.6）、甲基化（beta≥0.6）分布如下：</p>

<p class="center">
<div class="row gallery-row">
  <div class="col-1">
    <div id="gallery_figure_normbeta_button_prev" class="button_prev" onclick="prev(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_prev">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="8789.5,4902.8 8789.5,5846.4 6801.7,8000 8789.5,10253.6 8789.5,11097.2 5930.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-6">
    <div class="tab-content" id="gallery_figure_normbeta_nav-tabContent">
      {% for item in figure_normbeta %}
      {% if "normbetas" in item.1 %}
      <div class="tab-pane fade{% if forloop.first %} show active{% endif %}" id="gallery_figure_normbeta_pane_{{ item.0 }}" role="tabpanel"
        aria-labelledby="gallery_figure_normbeta_list_{{ item.0 }}" onclick="trans(this.id)"><img
          class="img-gallery" src="{{ item.1 }}" /></div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="col-1">
  <div id="gallery_figure_normbeta_button_next" class="button_next" onclick="next(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_next">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="7210.5,4902.8 7210.5,5846.4 9198.3,8000 7210.5,10253.6 7210.5,11097.2 10069.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-4">
    <input class="form-control" id="gallery_figure_normbeta_InputList" type="text" placeholder="Search..">
    <div class="list-group" id="gallery_figure_normbeta_list-tab" role="tablist">
      {% for item in figure_normbeta %}
      {% if "normbetas" in item.1 %}
      <a class="list-group-item list-group-item-action{% if forloop.first %} active{% endif %}" id="gallery_figure_normbeta_list_{{ item.0 }}"
        data-toggle="list" href="#gallery_figure_normbeta_pane_{{ item.0 }}" role="tab"
        aria-controls="{{ item.0 }}">{{ item.0 }} 甲基化beta值统计结果堆叠图</a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
</p>

{% if fig_qc_normbeta %}<p class="name_fig" style="font-weight: bold; text-align: center;">图 {{fig_qc_normbeta}} 甲基化beta值统计结果堆叠图</p>{% endif %}
<p class="premark">图注：横坐标为样本名称，纵坐标为位点数量，图柱中的不同颜色代表不同甲基化水平区间（对应关系见图例）。生物学重复之间的甲基化分布通常较为接近。</p>
<p class="premark">结果文件路径：见Result目录下1.QC/1_Raw_Data_and_Pre_Process/*normbetas_stat.png/pdf文件，作图数据基于同目录下统计文件：1_Raw_Data_and_Pre_Process/*/normbetas_stat.csv。</p>

<div id="page">
    <hr/>
    </p><br/>
    <a name="IGV可视化浏览"></a>
    {% if subsection_qc_igv %}<h4>{{subsection_qc_igv}}　可视化浏览</h4>{% endif %}
   <ol style="list-style: none; padding-left: 2em;">
  <li>（1）在不同尺度下显示单个或多个样本在基因组上特定位置的甲基化情况，包括在各个染色体和在注释的外显子、内含子、剪接接合区、基因间区的甲基化水平、位点分布等；</li>
  <li>（2）在不同尺度下显示不同区域的甲基化位点密度、水平；</li>
  <li>（3）显示基因的注释信息；</li>
  <li>（4） 既可以从远程服务器端下载各种注释信息，又可以从本地加载注释信息。</li>
    </ol>
    <p class="paragraph">如图所示：</p>

    <p class="center">
        <img class="normal4" style="width: 75%; display: block; margin: 0 auto;" src="images/igv1.png"/>
    </p>
    {% if fig_qc_igv %}<p class="name_fig" style="font-weight: bold; text-align: center;">图 {{fig_qc_igv}} IGV浏览器界面（demo）</p>{% endif %}
    <p class="paragraph">图注：上图为示例图片，实际结果可将Result目录下1_Raw_Data_and_Pre_Process/.VS./Allsample.igv文件输入到IGV软件中查看。</p>
</div>

<hr/>
</p><br/>
<a name="甲基化水平相关性热图"></a>
{% if subsection_qc_corr %}<h4>{{subsection_qc_corr}}　甲基化水平相关性热图</h4>{% endif %}
<p class="paragraph">
样本相关性热图用于展示样本之间的相关性，通过计算两两样本之间的相关系数进行作图。
</p>

<p class="center">
<div class="row gallery-row">
  <div class="col-1">
    <div id="gallery_figure_corr_button_prev" class="button_prev" onclick="prev(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_prev">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="8789.5,4902.8 8789.5,5846.4 6801.7,8000 8789.5,10253.6 8789.5,11097.2 5930.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-6">
    <div class="tab-content" id="gallery_figure_corr_nav-tabContent">
      {% for item in figure_corr %}
      {% if "Correlation" in item.1 %}
      <div class="tab-pane fade{% if forloop.first %} show active{% endif %}" id="gallery_figure_corr_pane_{{ item.0 }}" role="tabpanel"
        aria-labelledby="gallery_figure_corr_list_{{ item.0 }}" onclick="trans(this.id)"><img
          class="img-gallery" src="{{ item.1 }}" /></div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="col-1">
  <div id="gallery_figure_corr_button_next" class="button_next" onclick="next(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_next">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="7210.5,4902.8 7210.5,5846.4 9198.3,8000 7210.5,10253.6 7210.5,11097.2 10069.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-4">
    <input class="form-control" id="gallery_figure_corr_InputList" type="text" placeholder="Search..">
    <div class="list-group" id="gallery_figure_corr_list-tab" role="tablist">
      {% for item in figure_corr %}
      {% if "Correlation" in item.1 %}
      <a class="list-group-item list-group-item-action{% if forloop.first %} active{% endif %}" id="gallery_figure_corr_list_{{ item.0 }}"
        data-toggle="list" href="#gallery_figure_corr_pane_{{ item.0 }}" role="tab"
        aria-controls="{{ item.0 }}">{{ item.0 }} 样本相关性热图</a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
</p>

{% if fig_qc_corr %}<p class="name_fig" style="font-weight: bold; text-align: center;">图 {{fig_qc_corr}} 样本相关性热图</p>{% endif %}
<p class="premark">图注：图中横纵坐标均为样本，每一个点代表对应的这两个样本之间的相关性。颜色由蓝到红，表示两个样本间的相关性由低到高。样本相关性越高，那么整体甲基化状态越相似。</p>
<p class="premark">结果文件路径：见Result目录下1.QC/1_Raw_Data_and_Pre_Process/*Correlation.png/pdf文件，相关性数据见同目录下Correlation.txt文件。
</p>


{% endif %}

{% if flag_dmp %}
    <!----------------------------------------如果不做差异这一部分pca 和散点图 是不展示的----------------------------------------->
<hr/>
</p><br/>
<a name="beta值相关性散点图"></a>
<h4>{{subsection_qc_scatter}}　beta值相关性散点图</h4>
<p class="paragraph">通过对甲基化水平beta值绘制相关性散点图，可以直观了解两组样本总体甲基化分布集中趋势。</p>

<p class="center">
<div class="row gallery-row">
  <div class="col-1">
    <div id="gallery_figure_scatter_button_prev" class="button_prev" onclick="prev(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_prev">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="8789.5,4902.8 8789.5,5846.4 6801.7,8000 8789.5,10253.6 8789.5,11097.2 5930.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-6">
    <div class="tab-content" id="gallery_figure_scatter_nav-tabContent">
      {% for item in figure_scatter %}
      {% if "Scatter_plot" in item.1 %}
      <div class="tab-pane fade{% if forloop.first %} show active{% endif %}" id="gallery_figure_scatter_pane_{{ item.0 }}" role="tabpanel"
        aria-labelledby="gallery_figure_scatter_list_{{ item.0 }}" onclick="trans(this.id)"><img
          class="img-gallery" src="{{ item.1 }}" /></div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="col-1">
  <div id="gallery_figure_scatter_button_next" class="button_next" onclick="next(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_next">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="7210.5,4902.8 7210.5,5846.4 9198.3,8000 7210.5,10253.6 7210.5,11097.2 10069.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-4">
    <input class="form-control" id="gallery_figure_scatter_InputList" type="text" placeholder="Search..">
    <div class="list-group" id="gallery_figure_scatter_list-tab" role="tablist">
      {% for item in figure_scatter %}
      {% if "Scatter_plot" in item.1 %}
      <a class="list-group-item list-group-item-action{% if forloop.first %} active{% endif %}" id="gallery_figure_scatter_list_{{ item.0 }}"
        data-toggle="list" href="#gallery_figure_scatter_pane_{{ item.0 }}" role="tab"
        aria-controls="{{ item.0 }}">{{ item.0 }} 甲基化beta值相关性散点图</a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
</p>

<p class="name_fig" style="font-weight: bold; text-align: center;">图 {{fig_qc_scatter}} 甲基化beta值相关性散点图</p>
<p class="premark">图注：图中的点代表检测到的甲基化位点，横纵坐标为对应位点在不同分组内的平均甲基化水平；R代表组间相关性数值，R绝对值越大，表明两组样本间的位点甲基化特征越相似；p值代表显著性，一般认为p<0.05为显著相关。</p>
<p class="premark"> 结果文件路径：见Result目录下1.QC/1_Raw_Data_and_Pre_Process/*Scatter_plot.png/pdf文件。</p>

<hr/>
</p><br/>
<a name="甲基化水平PCA图"></a>
    {% if subsection_qc_pca %}<h4>{{subsection_qc_pca}}　甲基化水平PCA图</h4>{% endif %}
<p class="paragraph">
主成分分析（Principal Component Analysis， PCA）是一种掌握事物主要矛盾的统计分析方法，它可以从多元事物中解析出主要影响因素，通过正交变换将一组可能存在相关性的变量转换为一组线性不相关的变量，转换后的这组变量叫主成分，从而揭示事物的本质，简化复杂的问题。
</p>

<p class="center">
<div class="row gallery-row">
  <div class="col-1">
    <div id="gallery_figure_pca_button_prev" class="button_prev" onclick="prev(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_prev">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="8789.5,4902.8 8789.5,5846.4 6801.7,8000 8789.5,10253.6 8789.5,11097.2 5930.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-6">
    <div class="tab-content" id="gallery_figure_pca_nav-tabContent">
      {% for item in figure_pca %}
      {% if "PCA_nolabel" in item.1 %}
      <div class="tab-pane fade{% if forloop.first %} show active{% endif %}" id="gallery_figure_pca_pane_{{ item.0 }}" role="tabpanel"
        aria-labelledby="gallery_figure_pca_list_{{ item.0 }}" onclick="trans(this.id)"><img
          class="img-gallery" src="{{ item.1 }}" /></div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="col-1">
  <div id="gallery_figure_pca_button_next" class="button_next" onclick="next(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_next">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="7210.5,4902.8 7210.5,5846.4 9198.3,8000 7210.5,10253.6 7210.5,11097.2 10069.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-4">
    <input class="form-control" id="gallery_figure_pca_InputList" type="text" placeholder="Search..">
    <div class="list-group" id="gallery_figure_pca_list-tab" role="tablist">
      {% for item in figure_pca %}
      {% if "PCA_nolabel" in item.1 %}
      <a class="list-group-item list-group-item-action{% if forloop.first %} active{% endif %}" id="gallery_figure_pca_list_{{ item.0 }}"
        data-toggle="list" href="#gallery_figure_pca_pane_{{ item.0 }}" role="tab"
        aria-controls="{{ item.0 }}">{{ item.0 }} 甲基化水平PCA图</a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
</p>

{% if fig_qc_pca %}<p class="name_fig" style="font-weight: bold; text-align: center;">图 {{fig_qc_pca}} 甲基化水平PCA图</p>{% endif %}
<p class="premark">图注：图中横坐标和纵坐标分别代表主成分PC1和主成分PC2，两者相互垂直互不影响。不同的颜色的点代表不同的分组，通过空间距离展示样本间相互关系的远近。</p>
<p class="premark">结果文件路径：见Result目录下1.QC/1_Raw_Data_and_Pre_Process/*_Beta_Norm_PCA_nolabel.png/pdf文件，由于分组内的样本以相同颜色展示，若存在离群样本的情况，只看图片难以区分是组内哪一个样本离群，可通过查看同目录下Sample_Beta_Norm_PCA.png/pdf文件即可，该图标注了样本名。</p>


<!----------------------------------------差异甲基化位点（DMP）----------------------------------------->
<hr/>
</p><br/>
{% if section_dmp %}<h3 id="id_order_dmp"><a id="差异甲基化位点（DMP）">{{section_dmp}}　差异甲基化位点（DMP）</a></h3>{% endif %}
    <a name="DMP分析流程"></a>
    {% if subsection_dmp_process %}<h4>{{subsection_dmp_process}}　DMP分析流程</h4>{% endif %}
    <p class="paragraph">
差异甲基化位点（Differentially Methylated CpG Positions ，DMP）是甲基化研究的主要环节，对于寻找后续biomarker有重要意义；在进行DMP鉴定时，首先对两组样本进行分组，然后利用sesame（SEnsible Step-wise Analysis of DNA MEthylation BeadChips）软件混合线性模型对两组样本进行分析，获得检测的差异甲基化位点，再进行FDR校正，得到 adj.P.Val 值。 在利用差异显著性p值进行筛选时，通常情况下会优先筛选 adj.P.Val<0.05 和 |delta bete| ≧ 0.2 的位点作为差异甲基化位点，实际应用中会根据项目具体情况进行调整，本项目采用 P.Value<0.05，|delta_beta|≧0.1 进行差异位点的筛选。
    </p>
    <hr/>
    <a name="DMP结果表"></a>
     {% if subsection_dmp_table %}<h4>{{subsection_dmp_table}}　DMP数据展示表</h4>{% endif %}
    {% if table_dmp %}<p class="name_table" style="text-align: center; font-weight: bold;">表 3-1 DMP数据展示表</p>{% endif %}
    <p class="center">
        <div id="tb">
            <table class="gy">
                <tr>
                    <th>Probe_ID</th>
                    <th>logFC</th>
                    <th>P_Value</th>
                    <th>adj_P_Val</th>
                    <th>control_AVG</th>
                    <th>case_AVG</th>
                    <th>deltaBeta</th>
                    <th>CHR</th>
                    <th>MAPINFO</th>
                    <th>Strand</th>
                    <th>Type</th>
                    <th>gene</th>
                    <th>feature</th>
                    <th>cgi</th>
                    <th>feat.cgi</th>
                    <th>feat.UCSC_Islands_Name</th>
                </tr>
                {% for each in table_dmp %}
                <tr>
                    <td>{{each.0}}</td>
                    <td>{{each.1}}</td>
                    <td>{{each.2}}</td>
                    <td>{{each.3}}</td>
                    <td>{{each.4}}</td>
                    <td>{{each.5}}</td>
                    <td>{{each.6}}</td>
                    <td>{{each.7}}</td>
                    <td>{{each.8}}</td>
                    <td>{{each.9}}</td>
                    <td>{{each.10}}</td>
                    <td>{{each.11}}</td>
                    <td>{{each.12}}</td>
                    <td>{{each.13}}</td>
                    <td>{{each.14}}</td>
                    <td>{{each.15}}</td>
                </tr>
                {% endfor %}
            </table>
        </div>
        </p>
        <p class="paragraph">数据质量情况详细内容如下：</p>
            <ol style="list-style: none; padding-left: 2em;">
              <li>(1) Probe_ID：探针名称。</li>
              <li>(2) logFC：FC（fold change）的对数值。</li>
              <li>(3) P_Value：p值。</li>
              <li>(4) adj_P_Val：矫正后的p值。</li>
              <li>(5) control_AVG：组1平均beta值。</li>
              <li>(6) case_AVG：组2平均beta值。</li>
              <li>(7) deltaBeta：Beta值的组间差值。</li>
              <li>(8) CHR：参考基因组GRCh38中对应的染色体号。</li>
              <li>(9) MAPINFO：染色体位置信息。</li>
              <li>(10) Strand：设计探针为正向序列F或反向序列R。</li>
              <li>(11) Type：该位点探针类型，I型或者为II型。</li>
              <li>(12) gene：基因名称。</li>
              <li>(13) feature：特征类型。</li>
              <li>(14) cgi：CpG island，甲基化岛。</li>
              <li>(15) feat.cgi：甲基化岛区域特征类型。</li>
              <li>(16) feat.UCSC_Islands_Name：UCSC库中甲基化岛（CGI）名。</li>
            </ol>
<p class="paragraph">
结果文件路径：见Result目录下2.DMP/*vs*/DMP_Significant_*absdeltaBeta.csv文件（项目使用的阈值体现在文件名上），同目录下allcpg.csv文件是未筛选结果。
</p>
<hr/>
<a name="火山图"></a>
{% if subsection_dmp_volcano %}<h4>{{subsection_dmp_volcano}}　火山图</h4>{% endif %}
<p class="paragraph">
火山图可以快速观察高、低甲基化位点的比例，单个比较组所有差异甲基化位点火山图如下图所示：
</p>

<p class="center">
<div class="row gallery-row">
  <div class="col-1">
    <div id="gallery_figure_volcano_button_prev" class="button_prev" onclick="prev(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_prev">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="8789.5,4902.8 8789.5,5846.4 6801.7,8000 8789.5,10253.6 8789.5,11097.2 5930.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-6">
    <div class="tab-content" id="gallery_figure_volcano_nav-tabContent">
      {% for item in figure_volcano %}
      <div class="tab-pane fade{% if forloop.first %} show active{% endif %}" id="gallery_figure_volcano_pane_{{ item.0 }}" role="tabpanel"
        aria-labelledby="gallery_figure_volcano_list_{{ item.0 }}" onclick="trans(this.id)"><img
          class="img-gallery" src="{{ item.1 }}" /></div>
      {% endfor %}
    </div>
  </div>
  <div class="col-1">
  <div id="gallery_figure_volcano_button_next" class="button_next" onclick="next(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_next">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="7210.5,4902.8 7210.5,5846.4 9198.3,8000 7210.5,10253.6 7210.5,11097.2 10069.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-4">
    <input class="form-control" id="gallery_figure_volcano_InputList" type="text" placeholder="Search..">
    <div class="list-group" id="gallery_figure_volcano_list-tab" role="tablist">
      {% for item in figure_volcano %}
      <a class="list-group-item list-group-item-action{% if forloop.first %} active{% endif %}" id="gallery_figure_volcano_list_{{ item.0 }}"
        data-toggle="list" href="#gallery_figure_volcano_pane_{{ item.0 }}" role="tab"
        aria-controls="{{ item.0 }}">{{ item.0 }} 火山图</a>
      {% endfor %}
    </div>
  </div>
</div>
</p>

{% if fig_dmp_volcano %}<p class="name_fig" style="font-weight: bold; text-align: center;">图 {{fig_dmp_volcano}} 火山图</p>{% endif %}
<p class="premark">图注：差异甲基化位点火山图中的每个点表示一个甲基化位点，横坐标为 Δβ，纵坐标为 -log(P.Value)，横坐标的两条临界线为 ±0.1，左上和右上的点为有样本差异的位点。分析中列出了 |Δβ|>0.1 的5个CpG位点和 P.Value<0.05 的5个CpG位点。横坐标绝对值越大，说明甲基化水平在两组样品间的差异越大；纵坐标值越大，表明差异越显著，筛选得到的差异位点越可靠。</p>
<p class="premark">结果文件路径：见Result目录下2.DMP/*vs*/DMP_Vocalno_plot_label.png/pdf文件。</p>
<hr/>
<a name="散点图"></a>
{% if subsection_dmp_scatter %}<h4>{{subsection_dmp_scatter}}　散点图</h4>{% endif %}
<p class="paragraph">
比较组散点图如下图所示：
</p>

<p class="center">
<div class="row gallery-row">
  <div class="col-1">
    <div id="gallery_figure_comScatter_button_prev" class="button_prev" onclick="prev(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_prev">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="8789.5,4902.8 8789.5,5846.4 6801.7,8000 8789.5,10253.6 8789.5,11097.2 5930.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-6">
    <div class="tab-content" id="gallery_figure_comScatter_nav-tabContent">
      {% for item in figure_comScatter %}
      <div class="tab-pane fade{% if forloop.first %} show active{% endif %}" id="gallery_figure_comScatter_pane_{{ item.0 }}" role="tabpanel"
        aria-labelledby="gallery_figure_comScatter_list_{{ item.0 }}" onclick="trans(this.id)"><img
          class="img-gallery" src="{{ item.1 }}" /></div>
      {% endfor %}
    </div>
  </div>
  <div class="col-1">
  <div id="gallery_figure_comScatter_button_next" class="button_next" onclick="next(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_next">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="7210.5,4902.8 7210.5,5846.4 9198.3,8000 7210.5,10253.6 7210.5,11097.2 10069.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-4">
    <input class="form-control" id="gallery_figure_comScatter_InputList" type="text" placeholder="Search..">
    <div class="list-group" id="gallery_figure_comScatter_list-tab" role="tablist">
      {% for item in figure_comScatter %}
      <a class="list-group-item list-group-item-action{% if forloop.first %} active{% endif %}" id="gallery_figure_comScatter_list_{{ item.0 }}"
        data-toggle="list" href="#gallery_figure_comScatter_pane_{{ item.0 }}" role="tab"
        aria-controls="{{ item.0 }}">{{ item.0 }} 火山图</a>
      {% endfor %}
    </div>
  </div>
</div>
</p>

{% if fig_dmp_scatter %}<p class="name_fig" style="font-weight: bold; text-align: center;">图 {{fig_dmp_scatter}} 散点图</p>{% endif %}
<p class="premark">图注：横坐标和纵坐标分别为分组的平均 beta 值。图中红色点代表 delta beta 有差异的位点，绿色代表没有差异的位点。</p>
<p class="premark">结果文件路径：见Result目录下2.DMP/*vs*/DMP_Scatter_plot.png/pdf文件。</p>
<hr/>
<a name="热图"></a>
{% if subsection_dmp_heatmap %}<h4>{{subsection_dmp_heatmap}}　热图</h4>{% endif %}
<p class="paragraph">
随机抽取5000个DMP（差异甲基化位点），不足5000个的选取全部的DMP做图。
</p>

<p class="center">
<div class="row gallery-row">
  <div class="col-1">
    <div id="gallery_figure_heatmap_button_prev" class="button_prev" onclick="prev(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_prev">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="8789.5,4902.8 8789.5,5846.4 6801.7,8000 8789.5,10253.6 8789.5,11097.2 5930.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-6">
    <div class="tab-content" id="gallery_figure_heatmap_nav-tabContent">
      {% for item in figure_heatmap %}
      <div class="tab-pane fade{% if forloop.first %} show active{% endif %}" id="gallery_figure_heatmap_pane_{{ item.0 }}" role="tabpanel"
        aria-labelledby="gallery_figure_heatmap_list_{{ item.0 }}" onclick="trans(this.id)"><img
          class="img-gallery" src="{{ item.1 }}" /></div>
      {% endfor %}
    </div>
  </div>
  <div class="col-1">
  <div id="gallery_figure_heatmap_button_next" class="button_next" onclick="next(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_next">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="7210.5,4902.8 7210.5,5846.4 9198.3,8000 7210.5,10253.6 7210.5,11097.2 10069.5,8000 ">
        </polygon>
      </svg></div>
  </div>
