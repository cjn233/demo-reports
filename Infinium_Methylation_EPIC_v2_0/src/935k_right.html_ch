  <div id="gallery_figure_pathway_dmr_button_next" class="button_next" onclick="next(this.id)">
      <svg viewbox="0 0 16000 16000" class="svg_next">
        <circle class="c" cx="8000" cy="8000" r="6080"></circle>
        <polygon class="a"
          points="7210.5,4902.8 7210.5,5846.4 9198.3,8000 7210.5,10253.6 7210.5,11097.2 10069.5,8000 ">
        </polygon>
      </svg></div>
  </div>
  <div class="col-4">
    <input class="form-control" id="gallery_figure_pathway_dmr_InputList" type="text" placeholder="Search..">
    <div class="list-group" id="gallery_figure_pathway_dmr_list-tab" role="tablist">
      {% for item in figure_pathway_dmr %}
      <a class="list-group-item list-group-item-action{% if forloop.first %} active{% endif %}" id="gallery_figure_pathway_dmr_list_{{ item.0 }}"
        data-toggle="list" href="#gallery_figure_pathway_dmr_pane_{{ item.0 }}" role="tab"
        aria-controls="{{ item.0 }}">{{ item.0 }} KEGG Pathway</a>
      {% endfor %}
    </div>
  </div>
</div>
</p>

{% if fig_kegg_dmr_pathway %}<p class="name_fig" style="font-weight: bold; text-align: center;">图 {{fig_kegg_dmr_pathway}} KEGG Pathway</p>{% endif %}
<p class="premark">图注：该图是利用Result目录下3_GO_KEGG/3_2_Differential_Methylation_Regions/.VS./KEGG_enrichment.csv文件中Link列下载的其中的一个KEGG Pathway图，若老师想得到更多KEGG Pathway图，请根据Link列自行下载即可.</p>

{% endif %}

<!----------------------------------------附录----------------------------------------->
<hr/>
</p><br/>
